# ==============================================================================
# NORDRIVE VTC — VARIABLES D'ENVIRONNEMENT (SITE WEB)
# ==============================================================================

# Supabase (Fallback persistant pour les données de la flotte si nécessaire)
VITE_SUPABASE_URL=https://<VOTRE-PROJET>.supabase.co
VITE_SUPABASE_ANON_KEY=<CLE_PUBLIQUE_SUPABASE>

# Cloudinary (Upload public des justificatifs chauffeurs)
# Cloud Name: <CLOUD_NAME_CLOUDINARY>
# Upload Preset: <PRESET_CLOUDINARY>

# Web3Forms (Envoi d'e-mails de notification sans backend)
# Access Key: <CLE_WEB3FORMS>

# Coordonnées Officielles de la Flotte
# Téléphone WhatsApp: 07 43 76 74 00 (Format international: +33743767400)
# Domaine Officiel: https://nordrive-flotte.com/

# Mesure d'audience sans cookie (laisser vide = aucune mesure, aucune requête)
# Option A : Umami (cloud.umami.is)
# VITE_UMAMI_WEBSITE_ID=
# Option B : Plausible (plausible.io)
# VITE_PLAUSIBLE_DOMAIN=nordrive-flotte.com
# Lien de partage du tableau de bord, affiché dans l'onglet admin « Statistiques »
# VITE_ANALYTICS_DASHBOARD_URL=
# Astuce : visiter une fois le site avec ?notrack=1 exclut votre navigateur des statistiques.
# ── Circuit sécurisé des formulaires (phase 1) ─────────────────────────────────────────────
# Laisser VIDE tant que les fonctions Supabase ne sont pas déployées : le site garde alors l'ancien circuit.
# VITE_API_URL=https://<VOTRE-PROJET>.supabase.co/functions/v1
# VITE_SUPABASE_ANON_KEY=<CLE_PUBLIQUE_SUPABASE>        (publique par conception : la base est verrouillée)
# VITE_TURNSTILE_SITE_KEY=<clé de site Cloudflare Turnstile>   (anti-robot, facultative au début)
#
# Secrets des fonctions (à définir côté Supabase : `supabase secrets set ...`, JAMAIS dans ce dépôt) :
#   ALLOWED_ORIGINS=https://nordrive-flotte.com,https://admin.nordrive-flotte.com
#   TURNSTILE_SECRET=...   REQUIRE_CAPTCHA=true
#   RESEND_API_KEY=...  NOTIFY_EMAIL_TO=equipe@...  NOTIFY_EMAIL_FROM=notifications@...